APP_NAME="Multilingual Chat"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_SUPPORTED_LOCALES=vi,en

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_ecommerce
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=reverb
CACHE_DRIVER=redis
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Payment Gateways
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL="${APP_URL}/payment/vnpay/callback"

MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL="${APP_URL}/payment/momo/callback"
MOMO_NOTIFY_URL="${APP_URL}/payment/momo/notify"

ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_CALLBACK_URL="${APP_URL}/payment/zalopay/callback"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_SECRET=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_SECRET=

# USDT Payment
USDT_WALLET_ADDRESS=
USDT_NETWORK=TRC20
USDT_API_KEY=

# SMS Gateway
SMS_GATEWAY=twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Pusher for real-time notifications
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# AI Chatbot
OPENAI_API_KEY=
CHATBOT_ENABLED=true
CHATBOT_MODEL=gpt-3.5-turbo

# DHRU/GSM API
DHRU_API_URL=https://dhru.example.com/api
DHRU_API_KEY=
DHRU_USERNAME=

GSM_API_URL=https://gsm.example.com/api
GSM_API_KEY=

# AWS S3 (optional for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Laravel Reverb (WebSocket Server)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# JWT Authentication
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

# Agora.io (Video/Audio Streaming)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

VITE_AGORA_APP_ID="${AGORA_APP_ID}"

# WebRTC Configuration
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
WEBRTC_TURN_SERVER=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=

# Social OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="${APP_URL}/auth/apple/callback"

# File Upload & Storage
MAX_UPLOAD_SIZE=52428800
MAX_VIDEO_SIZE=104857600
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
ALLOWED_VIDEO_TYPES=mp4,webm,mov
ALLOWED_AUDIO_TYPES=mp3,wav,ogg,m4a

# Video Processing
FFMPEG_BINARIES=/usr/bin/ffmpeg
FFPROBE_BINARIES=/usr/bin/ffprobe
VIDEO_QUALITY_SD=480
VIDEO_QUALITY_HD=720
VIDEO_QUALITY_FHD=1080

# Translation Service
TRANSLATION_ENABLED=true
TRANSLATION_CACHE_ENABLED=true

# Content Moderation
CONTENT_MODERATION_ENABLED=true
AI_MODERATION_API_KEY=
BANNED_WORDS=fuck,shit,damn

# App Features Toggle
FEATURE_LIVE_STREAMING=true
FEATURE_VIDEO_CALL=true
FEATURE_VOICE_ROOMS=true
FEATURE_KARAOKE=true
FEATURE_MINI_GAMES=true
FEATURE_SHORT_VIDEOS=true
FEATURE_DATING=true
FEATURE_GUILDS=true

# Rate Limiting
RATE_LIMIT_MESSAGE=60
RATE_LIMIT_MESSAGE_VIP=unlimited
RATE_LIMIT_API=100
RATE_LIMIT_LOGIN=5

# Coin System
COIN_TO_VND_RATE=100
MINIMUM_WITHDRAWAL=500000
WITHDRAWAL_FEE_PERCENT=5
STREAMER_COMMISSION_PERCENT=40

# VIP Pricing (VND)
VIP_BRONZE_PRICE=100000
VIP_SILVER_PRICE=200000
VIP_GOLD_PRICE=500000
VIP_PLATINUM_PRICE=1000000
VIP_DIAMOND_PRICE=2000000
VIP_KING_PRICE=5000000
VIP_EMPEROR_PRICE=10000000

# Daily Rewards
DAILY_LOGIN_COINS=100
DAILY_MESSAGE_COINS=50
DAILY_GIFT_COINS=200
DAILY_ROOM_COINS=100
DAILY_LIVESTREAM_COINS=150
DAILY_ONLINE_HOURS_COINS=300

# Firebase (Push Notifications - Optional)
FIREBASE_CREDENTIALS=
FIREBASE_DATABASE_URL=

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=
MIXPANEL_TOKEN=

# Email Verification
EMAIL_VERIFICATION_REQUIRED=true
PHONE_VERIFICATION_REQUIRED=false

# Security
TWO_FACTOR_ENABLED=false
PASSWORD_MIN_LENGTH=8
SESSION_ENCRYPT=true

# Debug & Logging
LOG_SLACK_WEBHOOK_URL=
SENTRY_LARAVEL_DSN=
